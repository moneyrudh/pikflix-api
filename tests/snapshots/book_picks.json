{
  "$defs": {
    "BookPick": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "description": "The primary author's full name",
          "title": "Author",
          "type": "string"
        },
        "reason": {
          "description": "A brief one-sentence explanation of why this matches the query",
          "title": "Reason",
          "type": "string"
        },
        "title": {
          "description": "The book's title as published, without series numbering",
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Year of first publication, or null if unsure",
          "title": "Year"
        }
      },
      "required": [
        "title",
        "author",
        "year",
        "reason"
      ],
      "title": "BookPick",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "description": "A list of exactly 12 recommendations",
      "items": {
        "$ref": "#/$defs/BookPick"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "BookPicks",
  "type": "object"
}
